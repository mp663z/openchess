[
  {"name": "quota reserve for commit", "op": "quota.reserve",
   "idem": "flow-q1",
   "body": {"operation_kind": "analysis", "estimated_units": 10,
            "hold_seconds": 60},
   "expect_status": 200, "store": {"reservation_id": "RSV"}},
  {"name": "quota commit", "op": "quota.commit", "idem": "flow-q2",
   "body": {"reservation_id": "{RSV}", "actual_units": 8},
   "expect_status": 200},
  {"name": "quota commit unknown", "op": "quota.commit", "idem": "flow-q3",
   "body": {"reservation_id": "rsv-nope", "actual_units": 1},
   "expect_status": 404, "expect_error": "not_found"},
  {"name": "quota reserve for release", "op": "quota.reserve",
   "idem": "flow-q4",
   "body": {"operation_kind": "analysis", "estimated_units": 5,
            "hold_seconds": 60},
   "expect_status": 200, "store": {"reservation_id": "RSV2"}},
  {"name": "quota release", "op": "quota.release", "idem": "flow-q5",
   "body": {"reservation_id": "{RSV2}"}, "expect_status": 200},
  {"name": "quota release unknown", "op": "quota.release",
   "idem": "flow-q6", "body": {"reservation_id": "rsv-nope"},
   "expect_status": 404, "expect_error": "not_found"},
  {"name": "register key", "op": "provider_routing.register_key",
   "idem": "flow-k1",
   "body": {"provider_kind": "generic-a", "key_material": "12345678"},
   "expect_status": 200, "store": {"key_ref": "KEY"}},
  {"name": "route with own key", "op": "provider_routing.route",
   "body": {"capability": "analysis-fast"}, "expect_status": 200},
  {"name": "revoke key", "op": "provider_routing.revoke_key",
   "idem": "flow-k2", "body": {"key_ref": "{KEY}"}, "expect_status": 200},
  {"name": "revoke unknown key", "op": "provider_routing.revoke_key",
   "idem": "flow-k3", "body": {"key_ref": "key-nope"},
   "expect_status": 404, "expect_error": "not_found"},
  {"name": "route platform fallback", "op": "provider_routing.route",
   "body": {"capability": "analysis-fast"}, "expect_status": 200},
  {"name": "boundary unknown operation", "op": null, "method": "POST",
   "path": "/identity/teleport", "idem": "flow-x1", "body": {},
   "expect_status": 404, "expect_error": "malformed_request"},
  {"name": "boundary wrong method", "op": null, "method": "GET",
   "path": "/identity/register",
   "expect_status": 404, "expect_error": "malformed_request"}
]
