    {
      "name": "identity-differs-variant",
      "note": "identity carries the variant id: the same board under a different variant is a DIFFERENT position",
      "changed_fields": ["variant"],
      "expect": "different",
      "deferred": {
        "reason": "the contract registry declares a single variant (standard); a two-variant pair is not expressible without inventing a variant the contract does not declare - presence of the field in every identity tuple is enforced via the happy/boundary shapes instead",
        "reverify": "when variants.entries gains a second id, replace this marker with an executable pair spanning both declared variants and drop the deferred block"
      }
    }
  ],
